# Cloudflare Pages response headers.
# CSS and JS are always linked with ?v=… (bumped on every change), so browsers can keep them for a year.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
# Images, video and fonts: a week, so a replaced picture still shows up within days
/media/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
